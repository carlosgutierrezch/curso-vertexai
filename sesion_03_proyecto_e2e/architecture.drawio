          <mxGeometry x="880" y="110" width="160" height="40" as="geometry" />
        </mxCell>

        <!-- Workbench pattern note -->
        <mxCell id="cf-pattern" value="🧪 PATRÓN WORKBENCH&#xa;&#xa;El código Python de la Function vive como&#xa;STRING dentro del notebook. Se escribe a&#xa;/tmp/cf_event_router/main.py y se despliega&#xa;con `gcloud functions deploy`.&#xa;&#xa;Una sola fuente de verdad: notebook = código + deploy." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#4285F4;align=left;spacingLeft=10;fontSize=10;dashed=1;" vertex="1" parent="layer3">
          <mxGeometry x="1080" y="40" width="380" height="130" as="geometry" />
        </mxCell>

        <!-- IAM blocker -->
        <mxCell id="iam-block" value="⏳ IAM PENDIENTE&#xa;&#xa;Falta `roles/cloudfunctions.developer` para deploy.&#xa;Plan B: mostrar el código en pantalla y demo manual&#xa;del Workflow standalone.&#xa;&#xa;Comandos para destrabar en sesion_03_proyecto_e2e/&#xa;README.md (sección 'Permisos a nivel de proyecto')." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE8E6;strokeColor=#EA4335;align=left;spacingLeft=10;fontSize=10;" vertex="1" parent="layer3">
          <mxGeometry x="1490" y="40" width="800" height="130" as="geometry" />
        </mxCell>

        <!-- ============================================================ -->
        <!-- CAPA 4 — CLOUD WORKFLOWS (M5) -->
        <!-- ============================================================ -->
        <mxCell id="layer4" value="④ ORQUESTACIÓN — Cloud Workflows: retention-pipeline (M5)" style="swimlane;fontStyle=1;fontSize=13;startSize=28;fillColor=#E8F0FE;strokeColor=#4285F4;swimlaneFillColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="40" y="750" width="2320" height="200" as="geometry" />
        </mxCell>

        <!-- Workflows icon -->
        <mxCell id="wf-icon" value="" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#23445D;gradientColor=none;fillColor=#ffffff;strokeColor=#4285F4;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;shape=mxgraph.gcp2.workflows;" vertex="1" parent="layer4">
          <mxGeometry x="60" y="60" width="60" height="54" as="geometry" />
        </mxCell>
        <mxCell id="wf-lbl" value="Cloud Workflows&#xa;retention-pipeline&#xa;YAML declarativo&#xa;~16s end-to-end" style="text;html=1;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="layer4">
          <mxGeometry x="20" y="120" width="140" height="50" as="geometry" />
        </mxCell>

        <!-- 4 steps -->
        <mxCell id="wf-step0" value="resolver_target_month&#xa;&#xa;assign:&#xa;  target_month: ${args.target_month}&#xa;  run_id: ${uuid.generate()}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4285F4;align=left;spacingLeft=8;fontSize=10;" vertex="1" parent="layer4">
          <mxGeometry x="190" y="55" width="240" height="120" as="geometry" />
        </mxCell>

        <mxCell id="wf-step1" value="paso_1_build_features&#xa;&#xa;CALL sp_build_retention_features(target_month)&#xa;labels: step=build_features&#xa;maximumBytesBilled: 50 GB" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4285F4;align=left;spacingLeft=8;fontSize=10;" vertex="1" parent="layer4">
          <mxGeometry x="460" y="55" width="320" height="120" as="geometry" />
        </mxCell>

        <mxCell id="wf-step2" value="paso_2_score&#xa;&#xa;CALL sp_score_retention(target_month)&#xa;labels: step=score&#xa;ML.PREDICT con retention_logistic_v1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4285F4;align=left;spacingLeft=8;fontSize=10;" vertex="1" parent="layer4">
          <mxGeometry x="810" y="55" width="320" height="120" as="geometry" />
        </mxCell>

        <mxCell id="wf-step3" value="paso_3_apply_decision&#xa;&#xa;CALL sp_apply_decision_rule(target_month)&#xa;labels: step=apply_decision&#xa;Aplica regla newsvendor τ* por tier" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4285F4;align=left;spacingLeft=8;fontSize=10;" vertex="1" parent="layer4">
          <mxGeometry x="1160" y="55" width="320" height="120" as="geometry" />
        </mxCell>

        <mxCell id="wf-step4" value="paso_4_snapshot  (try / except)&#xa;&#xa;CREATE SNAPSHOT TABLE retention_actions_snap_*&#xa;CLONE retention_actions&#xa;Nice-to-have: si falla NO aborta el pipeline" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4285F4;align=left;spacingLeft=8;fontSize=10;dashed=1;" vertex="1" parent="layer4">
          <mxGeometry x="1510" y="55" width="380" height="120" as="geometry" />
        </mxCell>

        <mxCell id="wf-return" value="return_status&#xa;&#xa;{ status: SUCCESS,&#xa;  target_month,&#xa;  run_id }" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4285F4;align=left;spacingLeft=8;fontSize=10;" vertex="1" parent="layer4">
          <mxGeometry x="1920" y="55" width="180" height="120" as="geometry" />
        </mxCell>

        <!-- ============================================================ -->
        <!-- CAPA 5 — STORED PROCEDURES + BIGQUERY (M6) -->
        <!-- ============================================================ -->
        <mxCell id="layer5" value="⑤ EL CEREBRO — Stored Procedures idempotentes + BigQuery (M6)" style="swimlane;fontStyle=1;fontSize=13;startSize=28;fillColor=#E6F4EA;strokeColor=#34A853;swimlaneFillColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="40" y="970" width="2320" height="280" as="geometry" />
        </mxCell>

        <!-- SP build features -->
        <mxCell id="sp-build-icon" value="" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#23445D;gradientColor=none;fillColor=#E8F0FE;strokeColor=#4285F4;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;shape=mxgraph.gcp2.bigquery;" vertex="1" parent="layer5">
          <mxGeometry x="40" y="55" width="50" height="44" as="geometry" />
        </mxCell>
        <mxCell id="sp-build" value="sp_build_retention_features(target_month)&#xa;feature_store_retention&#xa;&#xa;BEGIN&#xa;  DELETE WHERE snapshot_month = target&#xa;          ↑ idempotencia&#xa;  INSERT INTO features SELECT&#xa;    (CTEs: snapshot_now, snapshot_6m_ago,&#xa;     team_medians, future_voluntary_exits ← LABEL)&#xa;  LOG SUCCESS en pipeline_runs&#xa;EXCEPTION WHEN ERROR THEN&#xa;  LOG FAILED + RAISE&#xa;END" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#34A853;align=left;spacingLeft=8;fontSize=10;" vertex="1" parent="layer5">
          <mxGeometry x="100" y="40" width="380" height="200" as="geometry" />
        </mxCell>

        <!-- features table (BQ) -->
        <mxCell id="tbl-features-icon" value="" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#23445D;gradientColor=none;fillColor=#ffffff;strokeColor=#4285F4;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;shape=mxgraph.gcp2.bigquery;" vertex="1" parent="layer5">
          <mxGeometry x="510" y="55" width="50" height="44" as="geometry" />
        </mxCell>
        <mxCell id="tbl-features" value="features  (tabla)&#xa;&#xa;1 fila / (employee × snapshot)&#xa;&#xa;PARTITION BY snapshot_month&#xa;CLUSTER BY country, team&#xa;require_partition_filter = TRUE  ⭐&#xa;partition_expiration_days = 730&#xa;&#xa;Cols: tenure_*, compa_ratio_team,&#xa;salary_delta_pct_6m, has_bonus, fte,&#xa;voluntary_exit_within_3m  ← LABEL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#34A853;align=left;spacingLeft=8;fontSize=10;" vertex="1" parent="layer5">
          <mxGeometry x="570" y="40" width="280" height="200" as="geometry" />
        </mxCell>

        <!-- SP score -->
        <mxCell id="sp-score-icon" value="" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#23445D;gradientColor=none;fillColor=#E8F0FE;strokeColor=#4285F4;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;shape=mxgraph.gcp2.bigquery;" vertex="1" parent="layer5">
          <mxGeometry x="880" y="55" width="50" height="44" as="geometry" />
        </mxCell>
        <mxCell id="sp-score" value="sp_score_retention(target_month)&#xa;predictions_retention&#xa;&#xa;DELETE WHERE snapshot_month = target&#xa;INSERT INTO scores&#xa;SELECT prob_class_0, prob_class_1, scored_at&#xa;FROM ML.PREDICT(&#xa;  MODEL ml_models.retention_logistic_v1,&#xa;  features WHERE snapshot_month = target)&#xa;LOG SUCCESS / FAILED en pipeline_runs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#34A853;align=left;spacingLeft=8;fontSize=10;" vertex="1" parent="layer5">
          <mxGeometry x="940" y="40" width="380" height="200" as="geometry" />
        </mxCell>

        <!-- scores table -->
        <mxCell id="tbl-scores-icon" value="" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#23445D;gradientColor=none;fillColor=#ffffff;strokeColor=#4285F4;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;shape=mxgraph.gcp2.bigquery;" vertex="1" parent="layer5">
          <mxGeometry x="1350" y="55" width="50" height="44" as="geometry" />
        </mxCell>
        <mxCell id="tbl-scores" value="scores  (tabla)&#xa;&#xa;1 fila / (employee × snapshot)&#xa;&#xa;PARTITION BY snapshot_month&#xa;CLUSTER BY country, team&#xa;&#xa;Cols:&#xa;• actual_label (solo en hold-out)&#xa;• prob_class_0, prob_class_1&#xa;• scored_at" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#34A853;align=left;spacingLeft=8;fontSize=10;" vertex="1" parent="layer5">
          <mxGeometry x="1410" y="40" width="240" height="200" as="geometry" />
        </mxCell>

        <!-- SP decision -->
        <mxCell id="sp-decision-icon" value="" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#23445D;gradientColor=none;fillColor=#E8F0FE;strokeColor=#4285F4;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;shape=mxgraph.gcp2.bigquery;" vertex="1" parent="layer5">
          <mxGeometry x="1680" y="55" width="50" height="44" as="geometry" />
        </mxCell>
        <mxCell id="sp-decision" value="sp_apply_decision_rule(target_month)&#xa;predictions_retention&#xa;&#xa;DELETE WHERE snapshot_month = target&#xa;INSERT INTO retention_actions&#xa;SELECT s.*,&#xa;  tier_from_position(position) AS tier,&#xa;  cp.tau_star,&#xa;  CASE WHEN prob ≥ τ*           → 'retention_action'&#xa;       WHEN prob ≥ 0.85 × τ*    → 'monitor'&#xa;       ELSE                      'no_action' END,&#xa;  priority 1..5&#xa;FROM scores s JOIN cost_params_retention cp" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#34A853;align=left;spacingLeft=8;fontSize=10;" vertex="1" parent="layer5">
          <mxGeometry x="1740" y="40" width="380" height="200" as="geometry" />
        </mxCell>

        <!-- retention_actions output -->
        <mxCell id="tbl-actions-icon" value="" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#23445D;gradientColor=none;fillColor=#E6F4EA;strokeColor=#34A853;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;shape=mxgraph.gcp2.bigquery;" vertex="1" parent="layer5">
          <mxGeometry x="2150" y="55" width="50" height="44" as="geometry" />
        </mxCell>
        <mxCell id="tbl-actions" value="retention_actions&#xa;&#xa;✅ OUTPUT&#xa;FINAL&#xa;&#xa;PARTITION BY&#xa;snapshot_month&#xa;CLUSTER BY&#xa;country,&#xa;recommended_action&#xa;&#xa;1 fila /&#xa;empleado activo" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F4EA;strokeColor=#34A853;align=center;fontSize=10;fontStyle=1;" vertex="1" parent="layer5">
          <mxGeometry x="2210" y="40" width="100" height="200" as="geometry" />
        </mxCell>

        <!-- Pattern note -->
        <mxCell id="sp-pattern-note" value="🧬 Patrón canónico de SP idempotente: BEGIN  DELETE  INSERT  LOG  EXCEPTION WHEN ERROR  RAISE  END.  Replicar en TODOS los SPs del data warehouse." style="text;html=1;fontSize=10;align=center;fontStyle=2;fillColor=#E6F4EA;strokeColor=#34A853;rounded=1;" vertex="1" parent="layer5">
          <mxGeometry x="40" y="245" width="2240" height="25" as="geometry" />
        </mxCell>

        <!-- ============================================================ -->
        <!-- CAPA 6 — OBSERVABILIDAD + STATUS -->
        <!-- ============================================================ -->
        <mxCell id="layer6" value="⑥ OBSERVABILIDAD + GOBIERNO + STATUS" style="swimlane;fontStyle=1;fontSize=13;startSize=28;fillColor=#FCE8E6;strokeColor=#EA4335;swimlaneFillColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="40" y="1270" width="2320" height="240" as="geometry" />
        </mxCell>

        <!-- Authorized view + k-anon -->
        <mxCell id="view-icon" value="" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#23445D;gradientColor=none;fillColor=#ffffff;strokeColor=#4285F4;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;shape=mxgraph.gcp2.bigquery;" vertex="1" parent="layer6">
          <mxGeometry x="40" y="55" width="50" height="44" as="geometry" />
        </mxCell>
        <mxCell id="view-lbl" value="v_retention_risk_dashboard&#xa;Authorized View · capa semántica&#xa;&#xa;CREATE VIEW gold_people_analytics.v_retention_risk_dashboard&#xa;AS SELECT snapshot_month, country, team, tier,&#xa;     recommended_action, priority,&#xa;     COUNT(*) AS empleados,&#xa;     AVG(retention_risk_score) AS avg_score&#xa;FROM retention_actions GROUP BY 1..6&#xa;HAVING COUNT(*) ≥ 5  ← k-anonymity&#xa;&#xa;HRBP lee la VISTA, no la tabla base." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#34A853;align=left;spacingLeft=8;fontSize=9;" vertex="1" parent="layer6">
          <mxGeometry x="100" y="40" width="380" height="180" as="geometry" />
        </mxCell>

        <!-- Snapshots -->
        <mxCell id="snapshots-icon" value="" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#23445D;gradientColor=none;fillColor=#ffffff;strokeColor=#4285F4;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;shape=mxgraph.gcp2.bigquery;" vertex="1" parent="layer6">
          <mxGeometry x="510" y="55" width="50" height="44" as="geometry" />
        </mxCell>
        <mxCell id="snapshots-lbl" value="Snapshots inmutables&#xa;retention_actions_snapshot_*&#xa;&#xa;CREATE SNAPSHOT TABLE&#xa;CLONE retention_actions&#xa;OPTIONS(expiration = +365 días)&#xa;&#xa;Coste ≈ 0 (delta-encoded)&#xa;Auditoría 1 año garantizada" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#34A853;align=left;spacingLeft=8;fontSize=9;" vertex="1" parent="layer6">
          <mxGeometry x="570" y="40" width="220" height="180" as="geometry" />
        </mxCell>

        <!-- pipeline_runs (BQ icon) -->
        <mxCell id="runs-icon" value="" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#23445D;gradientColor=none;fillColor=#ffffff;strokeColor=#4285F4;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;shape=mxgraph.gcp2.bigquery;" vertex="1" parent="layer6">
          <mxGeometry x="820" y="55" width="50" height="44" as="geometry" />
        </mxCell>
        <mxCell id="runs-lbl" value="pipeline_runs.retention_pipeline_runs&#xa;Audit log SP-by-SP&#xa;&#xa;Cols: run_id, step, snapshot_month,&#xa;rows_written, start_time, end_time,&#xa;duration_seconds, status, error_message&#xa;&#xa;PARTITION BY DATE(start_time)&#xa;CLUSTER BY step, status&#xa;&#xa;Responde 'qué pasó'." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#34A853;align=left;spacingLeft=8;fontSize=9;" vertex="1" parent="layer6">
          <mxGeometry x="880" y="40" width="280" height="180" as="geometry" />
        </mxCell>

        <!-- INFORMATION_SCHEMA -->
        <mxCell id="info-icon" value="" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#23445D;gradientColor=none;fillColor=#ffffff;strokeColor=#4285F4;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;shape=mxgraph.gcp2.bigquery;" vertex="1" parent="layer6">
          <mxGeometry x="1190" y="55" width="50" height="44" as="geometry" />
        </mxCell>
        <mxCell id="info-lbl" value="INFORMATION_SCHEMA.JOBS_BY_USER&#xa;FinOps integrado&#xa;&#xa;WHERE labels.pipeline = 'retention-risk'&#xa;&#xa;Métricas:&#xa;• total_bytes_billed → coste $&#xa;• total_slot_ms → coste compute&#xa;• duration_ms → SLA por step&#xa;&#xa;Cruzable con pipeline_runs:&#xa;'qué pasó' + 'cuánto costó'&#xa;&#xa;→ M12 (FinOps) + BI Engine" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#34A853;align=left;spacingLeft=8;fontSize=9;" vertex="1" parent="layer6">
          <mxGeometry x="1250" y="40" width="280" height="180" as="geometry" />
