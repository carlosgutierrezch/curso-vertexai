        <mxCell id="cf-lbl" value="event-router-retention&#xa;gen2 · Python 3.11&#xa;max-instances=5" style="text;html=1;fontSize=10;align=center;fontStyle=1;" vertex="1" parent="layer3">
          <mxGeometry x="40" y="120" width="140" height="40" as="geometry" />
        </mxCell>

        <!-- CF logic (steps inside) -->
        <mxCell id="cf-logic" value="LÓGICA DE LA FUNCTION&#xa;&#xa;1️⃣  decode base64 → JSON&#xa;2️⃣  structured log → Cloud Logging&#xa;3️⃣  FILTRO: si event_type ≠ PAYROLL_CLOSED → ack y descartar&#xa;4️⃣  si target_month ausente → raise ValueError → DLQ&#xa;5️⃣  workflows.executions.create({target_month, run_origin='event_driven'})&#xa;6️⃣  return → Pub/Sub ack" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FBBC04;align=left;spacingLeft=10;fontSize=10;" vertex="1" parent="layer3">
          <mxGeometry x="220" y="55" width="660" height="115" as="geometry" />
        </mxCell>

        <!-- Cloud Logging icon (right side) -->
        <mxCell id="logging-icon" value="" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#23445D;gradientColor=none;fillColor=#ffffff;strokeColor=#4285F4;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;shape=mxgraph.gcp2.cloud_logging;" vertex="1" parent="layer3">
          <mxGeometry x="930" y="60" width="50" height="44" as="geometry" />
        </mxCell>
