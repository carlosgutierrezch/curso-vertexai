        <mxCell id="logging-obs-lbl" value="Cloud Logging&#xa;structured logs&#xa;de la Function + del SP&#xa;&#xa;Log Sinks futuros (M17):&#xa;→ BigQuery dataset audit&#xa;→ Pub/Sub topic alerts" style="text;html=1;fontSize=9;align=center;" vertex="1" parent="layer6">
          <mxGeometry x="1860" y="105" width="200" height="80" as="geometry" />
