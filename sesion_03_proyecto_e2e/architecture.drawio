        <!-- GDPR critical box -->
        <mxCell id="gdpr" value="⚠ MARCO REGULATORIO — CRÍTICO&#xa;&#xa;GDPR Art. 22 (decisiones automatizadas)&#xa;Prohíbe que una predicción afecte significativamente a un trabajador SIN revisión humana.&#xa;&#xa;→ El output del pipeline es INPUT para HRBP, NO decisión final.&#xa;→ Human-in-the-loop OBLIGATORIO. El HRBP firma cada acción de retención.&#xa;&#xa;Estatuto Trabajadores Art. 20.3  ·  LOPDGDD  ·  filtro ético: Legal → Ético → Útil → Accionable" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE8E6;strokeColor=#EA4335;align=left;spacingLeft=10;fontSize=11;fontStyle=1;" vertex="1" parent="layer7">
