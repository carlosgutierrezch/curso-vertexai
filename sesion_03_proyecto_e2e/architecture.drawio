        <!-- Idempotency note -->
        <mxCell id="idempotency-note" value="🔒 IDEMPOTENCIA HEREDADA&#xa;&#xa;Los 3 caminos pueden coexistir SIN romper datos.&#xa;Si Scheduler y Eventarc disparan el mismo mes:&#xa;el SP DELETE+INSERT por partición → mismo resultado.&#xa;&#xa;Pub/Sub at-least-once (no exactly-once) cubierto&#xa;por la idempotencia de los SPs en M6." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E1;strokeColor=#FBBC04;align=left;spacingLeft=10;fontSize=10;" vertex="1" parent="layer2">
          <mxGeometry x="1640" y="40" width="650" height="190" as="geometry" />
